# Supabase browser-safe configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Public app origin used for magic-link callbacks and calendar metadata
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional local preview mode. Never enable this in a production deployment.
NEXT_PUBLIC_DEMO_MODE=false

# Import limits
MAX_SYLLABUS_SIZE_MB=15

# Provider-neutral extraction configuration (server only)
EXTRACTION_PROVIDER=fixture
EXTRACTION_MODEL=fixture-v1
# EXTRACTION_API_KEY=
